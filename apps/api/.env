# Amazon Bedrock (required -- the app fails fast at startup if these are
# missing; there are no defaults, since a wrong default could point at the
# wrong AWS account/region silently).
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional LLM call timeout (seconds), one retry is attempted on
# timeout/APIError before the job fails with LLM_ERROR.
LLM_TIMEOUT_SECONDS=60

# Upload / job limits
MAX_UPLOAD_BYTES=10485760
JOB_TTL_SECONDS=1800
TTL_SWEEP_INTERVAL_SECONDS=600

# Detection chunking (cost/context control)
DETECTION_CHUNK_CHAR_LIMIT=8000
DETECTION_MAX_BLOCKS_PER_CHUNK=20
DETECTION_MAX_CHUNKS_PER_JOB=50

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
