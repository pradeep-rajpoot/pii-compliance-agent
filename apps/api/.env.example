# Copy to .env and fill in. BEDROCK_REGION / BEDROCK_MODEL_ID have no
# defaults -- the app fails fast at startup if either is missing.

# AWS region the Bedrock model is invoked in.
BEDROCK_REGION=us-east-1

# Bedrock model or cross-region inference profile id, e.g.:
#   aws bedrock list-inference-profiles --region us-east-1 \
#     --query "inferenceProfileSummaries[?contains(inferenceProfileId,'claude')].inferenceProfileId"
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5

# Seconds to wait on a single Bedrock call before retrying once, then failing.
LLM_TIMEOUT_SECONDS=60

# Max upload size in bytes (default 10MB).
MAX_UPLOAD_BYTES=10485760

# How long a job (and its temp files) survives after last activity before
# the TTL sweep deletes it.
JOB_TTL_SECONDS=1800

# How often the TTL sweep runs.
TTL_SWEEP_INTERVAL_SECONDS=600

# Detection chunking limits (cost/context-window control).
DETECTION_CHUNK_CHAR_LIMIT=8000
DETECTION_MAX_BLOCKS_PER_CHUNK=20
DETECTION_MAX_CHUNKS_PER_JOB=50

# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000
